{
  "name": "opencode-chat-unofficial",
  "displayName": "opencode chat",
  "description": "opencode chat extension for local and remote VS Code workspaces",
  "repository": "https://github.com/kwickramasekara/opencode-chat",
  "publisher": "kwickramasekara",
  "version": "2.9.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/main.js",
  "contributes": {
    "commands": [
      {
        "command": "opencode.addToChat",
        "title": "opencode: Add File to Chat",
        "icon": "$(add)"
      },
      {
        "command": "opencode.toggleChatView",
        "title": "opencode: Toggle Sidebar Chat"
      },
      {
        "command": "opencode.toggleChatViewInPanelOrSidebar",
        "title": "opencode: Toggle Sidebar Chat"
      },
      {
        "command": "opencode.openChat",
        "title": "opencode: New Chat in Editor"
      },
      {
        "command": "opencode.openChatBeside",
        "title": "opencode: New Chat in Editor to the Side"
      },
      {
        "command": "opencode.restart",
        "title": "opencode: Restart Server"
      },
      {
        "command": "opencode.showOutput",
        "title": "opencode: Show Output Channel"
      },
      {
        "command": "opencode.addSelectionToChat",
        "title": "opencode: Add Selection to Chat",
        "icon": "$(add)"
      },
      {
        "command": "opencode.closeSidebarChat",
        "title": "opencode: Close Sidebar Chat",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opencode.toggleChatViewInPanelOrSidebar",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "opencode.openChat",
          "when": "view == opencode.chatView",
          "group": "navigation"
        },
        {
          "command": "opencode.closeSidebarChat",
          "when": "view == opencode.chatView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "opencode.addToChat",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencode.addToChat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "opencode.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "opencode",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "opencode",
      "properties": {
        "opencode.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Fixed port for the opencode server. Set to 0 (default) to use a random port. Note: changing the port resets preferences stored in the webview (e.g. theme) since they are tied to the origin."
        },
        "opencode.exposeToNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Expose the opencode server to the local network via mDNS. When enabled, you can access the same instance from another device at http://opencode.local:<port>."
        }
      }
    }
  },
  "scripts": {
    "copy-templates": "mkdir -p out/webview/templates && cp src/webview/templates/*.html out/webview/templates/",
    "compile": "tsc -p ./ && npm run copy-templates",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm test",
    "publish": "npm run compile && vsce publish && ovsx publish",
    "watch": "npm run copy-templates && tsc -w -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "license": "MIT"
}
